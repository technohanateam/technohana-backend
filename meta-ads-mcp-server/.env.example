# ==============================================================================
# Meta Ads MCP Server - Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ==============================================================================

# --- Server ---
NODE_ENV=development
PORT=3333
LOG_LEVEL=info
# Comma-separated list of origins allowed to call this server (besides the MCP connector itself)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- MCP / Connector auth ---
# HS256 signing secret used to verify bearer JWTs presented by the Claude Remote MCP Connector.
# Generate with: openssl rand -hex 32
MCP_JWT_SECRET=
# Previous signing secret, accepted during a key-rotation window. Leave blank if not rotating.
MCP_JWT_SECRET_PREVIOUS=
MCP_JWT_ISSUER=meta-ads-mcp-server
MCP_JWT_AUDIENCE=claude-mcp-connector
MCP_JWT_TTL_SECONDS=3600

# Shared secret used to HMAC-sign trusted server-to-server requests (e.g. OAuth callback verification).
REQUEST_SIGNING_SECRET=

# --- Meta App credentials (developers.facebook.com) ---
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
# Redirect URI registered on the Meta App, e.g. https://yourdomain.com/auth/meta/callback
META_OAUTH_REDIRECT_URI=http://localhost:3333/auth/meta/callback
# Space-separated Marketing API permissions requested during OAuth
META_OAUTH_SCOPES=ads_management ads_read business_management leads_retrieval pages_show_list

# --- Storage backend (token store + audit log) ---
# One of: file | redis | mongo | postgres
STORAGE_BACKEND=file
# Used only when STORAGE_BACKEND=file
FILE_STORE_PATH=./data/store.json
# AES-256-GCM key (32-byte hex) used to encrypt the file store at rest. Generate with: openssl rand -hex 32
FILE_STORE_ENCRYPTION_KEY=

STORAGE_REDIS_URL=redis://localhost:6379/0
STORAGE_MONGO_URI=mongodb://localhost:27017/meta_ads_mcp
STORAGE_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/meta_ads_mcp

# --- Cache backend ---
# One of: memory | redis
CACHE_BACKEND=memory
CACHE_REDIS_URL=redis://localhost:6379/1
CACHE_TTL_AD_ACCOUNTS_SECONDS=300
CACHE_TTL_BUSINESSES_SECONDS=300
CACHE_TTL_PIXELS_SECONDS=300
CACHE_TTL_ASSET_LIBRARY_SECONDS=180
CACHE_TTL_CAMPAIGN_METADATA_SECONDS=60

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# --- Bulk operations ---
BULK_MAX_BATCH_SIZE=50
BULK_MAX_CONCURRENCY=5

# --- Observability ---
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=meta-ads-mcp-server
# Optional. Leave blank to disable Sentry entirely.
SENTRY_DSN=

# --- AI service layer (ad copy generation, recommendations, reporting) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
